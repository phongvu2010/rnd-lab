# ------------------------------------------------------------------------------
# Cấu hình môi trường cho Research Lab (Vietnam Securities Investment Fund)
# Sao chép file này thành file `.env` và điền các thông tin kết nối thực tế.
# ------------------------------------------------------------------------------

# --- THỜI GIAN & LỊCH GIAO DỊCH (BUSINESS CALENDAR) ---
# Múi giờ chuẩn của thị trường chứng khoán Việt Nam
VIETNAM_TZ=Asia/Ho_Chi_Minh

# --- KẾT NỐI GOOGLE CLOUD BIGQUERY ---
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET_ID=your-dataset-id

# --- KẾT NỐI KAGGLE API (lấy từ file kaggle.json của tài khoản Kaggle) ---
# Kaggle Username
KAGGLE_USERNAME=your-kaggle-username
# Kaggle Dataset slug
KAGGLE_DATASET_SLUG=your-kaggle-dataset-slug

# --- KẾT NỐI POSTGRESQL ---
POSTGRES_SERVER=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=rnd_lab_db
ECHO_SQL=False

# Cấu hình OpenAI API (Dùng cho Alpha Agent)
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o

# # --- KẾT NỐI SUPABASE (lấy từ Settings -> API trong Dashboard) ---
# # URL của dự án Supabase
# SUPABASE_URL=https://your-supabase-id.supabase.co
# # Key dịch vụ của Supabase (anon_key hoặc service_role_key)
# SUPABASE_KEY=your-anon-secret-key

# # --- THỜI GIAN & LỊCH GIAO DỊCH (BUSINESS CALENDAR) ---
# # Giờ chốt dữ liệu cuối ngày (UTC+7)
# CUTOFF_TIME=20:30
# # Dung sai ngày bộ đệm cache mặc định (nếu không có cấu hình riêng cho chiến lược)
# DEFAULT_CACHE_MAX_AGE_DAYS=1
