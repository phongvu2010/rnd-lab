# ------------------------------------------------------------------------------
# Cấu hình môi trường cho Research Lab (Vietnam Securities Investment Fund)
# Sao chép file này thành file `.env` và điền các thông tin kết nối thực tế.
# ------------------------------------------------------------------------------

# --- THỜI GIAN & LỊCH GIAO DỊCH (BUSINESS CALENDAR) ---
# Múi giờ chuẩn của thị trường chứng khoán Việt Nam
VIETNAM_TZ=Asia/Ho_Chi_Minh

# --- KẾT NỐI KAGGLE API ---
# Kaggle Username (lấy từ file kaggle.json của tài khoản Kaggle)
KAGGLE_USERNAME=your-kaggle-username

# --- KẾT NỐI POSTGRESQL ---
POSTGRES_SERVER=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=rnd_lab_db
ECHO_SQL=False

# Cấu hình OpenAI API (Dùng cho Alpha Agent)
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-4o

# # --- KẾT NỐI SUPABASE ---
# # URL của dự án Supabase (lấy từ Settings -> API trong Dashboard)
# SUPABASE_URL=https://hoodudpakrackcbrevuo.supabase.co
# # Key dịch vụ của Supabase (anon_key hoặc service_role_key)
